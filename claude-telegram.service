[Unit]
Description=Claude Code Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nusendra
ExecStart=/home/nusendra/claude-telegram
Restart=on-failure
RestartSec=5
EnvironmentFile=/home/nusendra/.config/claude-telegram/.env

[Install]
WantedBy=multi-user.target
