[Unit]
Description=Claude Code Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USERNAME
ExecStart=/home/YOUR_USERNAME/claude-telegram
Restart=on-failure
RestartSec=5
EnvironmentFile=/home/YOUR_USERNAME/.config/claude-telegram/.env

[Install]
WantedBy=multi-user.target
